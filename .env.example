# Postgres connection string.
# Injected automatically into Vercel deployments by the Neon integration.
# For local development, run `vercel env pull .env.local` to fetch it.
DATABASE_URL=

# Secret used to sign the session cookie. Any long random string.
# Generate one with: npm run hash-passcode -- "your passcode"
# Changing this signs every device out.
AUTH_SECRET=

# scrypt hash of your login passcode. Generate with:
#   npm run hash-passcode -- "your passcode"
PASSCODE_HASH=
